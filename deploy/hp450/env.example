# Copy this file to /data/projects/moneyprinterturbo/.env on HP450.
# Pin deployments to a full commit SHA. Do not use latest in production.
MPT_IMAGE=ghcr.io/lightrao/moneyprinterturbo:sha-<40-character-commit-sha>
# Optional host path for the read-only Catalog video mount.
MPT_MATERIAL_VIDEO_DIR=/data/projects/mpt-material-catalog/videos
